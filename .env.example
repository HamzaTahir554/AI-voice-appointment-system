# ---------------------------------------------------------------------------
# AI Voice Appointment System - environment configuration
#
# Copy to `.env` and fill in your own values:
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Firebase -------------------------------------------------------------
# From: Firebase console -> Project settings -> Service accounts ->
#       "Generate new private key" (downloads a JSON file).
#
# Option A (recommended for servers): paste the three values here.
# The private key must keep its \n escapes and stay inside double quotes.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-YOUR-KEY-HERE\n-----END PRIVATE KEY-----\n"

# Option B (recommended for local development): point at the JSON file,
# stored OUTSIDE this repository so it can never be committed.
# FIREBASE_CREDENTIALS_FILE=C:/secure/serviceAccountKey.json

# Force the in-memory database even when Firebase is configured.
# Useful for tests and offline demos. Leave blank for normal operation.
USE_LOCAL_DB=

# --- Dialog behaviour -----------------------------------------------------
# Below this confidence the intent becomes unknown_intent and the assistant
# asks the caller to clarify instead of touching the database.
CONFIDENCE_THRESHOLD=0.60
# A higher bar for abandoning an in-progress booking mid-conversation.
INTENT_SWITCH_THRESHOLD=0.75
SESSION_TIMEOUT_MINUTES=15

# --- Ollama (local LLM: judge + natural response wording) -----------------
# The LLM never touches the database. It rephrases the Appointment Backend's
# result, and the response validator rejects anything that contradicts it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.2
# Cap the generation: a voice reply is one or two sentences. Uncapped, a small
# model rambles in JSON mode until the request times out.
OLLAMA_MAX_TOKENS=200
# Set to false to skip the LLM entirely and use deterministic templates.
OLLAMA_ENABLED=true
# Let the LLM translate turns with NO database operation (slot questions,
# greetings) into the caller's language. Off by default: a 3B model produces
# broken Roman Urdu and there is no backend result to validate it against.
# Enable it with a stronger model (llama3.1:8b, qwen2.5:7b).
OLLAMA_TRANSLATE=false

# --- Doctor dashboard -----------------------------------------------------
# The STARTING password for a doctor account. Real passwords live hashed in
# the `dashboard_accounts` collection: the administrator issues them and each
# doctor can change their own, and once one is stored the value below stops
# working for that account. Without either, sign-in is refused.
DASHBOARD_PASSWORD=
# ...or per doctor, by doctor id (overrides the shared one):
# DASHBOARD_PASSWORD_D001=
# How long a dashboard session lasts before it must sign in again.
DASHBOARD_SESSION_HOURS=12
# --- Clinic administrator (SuperAdmin) ------------------------------------
# The account that manages the doctors, their credentials, the clinics and
# every appointment (/admin/*). The password below is the starting one; the
# administrator can change it from Settings, after which it is stored hashed
# like everyone else's. Without either, administrator sign-in is refused.
SUPERADMIN_ID=ADMIN
SUPERADMIN_PASSWORD=

# Browser origins allowed to call the API. Not needed when the dashboard is
# served by the API itself at /ui (same origin). "null" covers a page opened
# directly from disk as a file:// URL.
# DASHBOARD_ORIGINS=http://localhost:8080,null

# --- Patient notifications (SMS / automated call) --------------------------
# The backend queues a message for every patient whose appointment a doctor
# cancels by blocking a day. Delivery is NOT implemented: no provider is
# bundled and no credentials belong in this repository. Naming a provider
# here only logs a warning until a sender is written.
# NOTIFICATION_PROVIDER=

# --- Appointments ---------------------------------------------------------
APPOINTMENT_ID_PREFIX=APT

# --- Regional -------------------------------------------------------------
# Appointment dates are resolved in this zone, never UTC.
TIMEZONE=Asia/Karachi

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
# Override only if the intent_detection module lives elsewhere.
# INTENT_MODULE_DIR=
